{
  "name": "qrrouter-web",
  "version": "0.3.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:mock": "node dev/start-mock.mjs",
    "mock": "node dev/server.mjs",
    "test:mock": "node --test dev/mock.test.mjs",
    "test:labels": "tsc --project tsconfig.print.json && node --test dev/labels.test.mjs",
    "test:csv": "node --test dev/csv.test.mjs",
    "build": "ng build && tsc --project tsconfig.print.json",
    "build:dev": "ng build --configuration development",
    "e2e": "playwright test",
    "e2e:mock": "playwright test --config playwright.mock.config.ts",
    "typecheck:e2e:mock": "tsc --project dev/e2e/tsconfig.json",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --plugin @prettier/plugin-php --write . ../dolibarr/qrrouter ../compose.yaml ../compose.dolibarr.yaml ../.prettierrc.json ../.csharpierrc.json ../dotnet-tools.json",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --plugin @prettier/plugin-php --check . ../dolibarr/qrrouter ../compose.yaml ../compose.dolibarr.yaml ../.prettierrc.json ../.csharpierrc.json ../dotnet-tools.json"
  },
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fortawesome/angular-fontawesome": "5.1.0",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "jsqr": "1.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.58.2",
    "@prettier/plugin-php": "0.26.0",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "qrcode": "1.5.4",
    "typescript": "6.0.3"
  }
}
