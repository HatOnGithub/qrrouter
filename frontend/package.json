{
  "name": "qrrouter-web",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "e2e": "playwright test",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --plugin @prettier/plugin-php --write . ../dolibarr/qrrouter ../compose.yaml ../compose.dolibarr.yaml ../.prettierrc.json ../.csharpierrc.json ../dotnet-tools.json",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --plugin @prettier/plugin-php --check . ../dolibarr/qrrouter ../compose.yaml ../compose.dolibarr.yaml ../.prettierrc.json ../.csharpierrc.json ../dotnet-tools.json"
  },
  "dependencies": {
    "@angular/animations": "21.1.5",
    "@angular/cdk": "21.1.5",
    "@angular/common": "21.1.5",
    "@angular/compiler": "21.1.5",
    "@angular/core": "21.1.5",
    "@angular/forms": "21.1.5",
    "@angular/material": "21.1.5",
    "@angular/platform-browser": "21.1.5",
    "@angular/router": "21.1.5",
    "jsqr": "1.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.1.4",
    "@angular/cli": "21.1.4",
    "@angular/compiler-cli": "21.1.5",
    "@playwright/test": "1.58.2",
    "@prettier/plugin-php": "0.26.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
